# Copy to .env, fill privately, and export before running server.py.
# Never commit real credentials. This file contains examples only.
FALA_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FALA_AI_MODEL=gemini-2.5-flash
FALA_AI_API_KEY=
# Required when binding to 0.0.0.0; choose your own strong access password.
FALA_ACCESS_PASSWORD=
# Exact browser origin, no path or trailing slash (GitHub Pages example):
FALA_ALLOWED_ORIGINS=https://liuxing9931-gif.github.io
# Per-process request limit, resets on restart. Set provider spending caps too.
FALA_MAX_REQUESTS=100
